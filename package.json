{
  "name": "nuxt-tw-template",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --open",
    "generate": "nuxt generate",
    "lint": "yarn lint:prettier && yarn lint:js && yarn lint:typecheck && yarn lint:style",
    "lint:fix": "yarn lint:prettier:fix && yarn lint:js --fix && yarn lint:style --fix && yarn lint:typecheck",
    "lint:inspect": "npx @eslint/config-inspector",
    "lint:js": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write --list-different .",
    "lint:style": "stylelint \"./**/*.{css,scss,vue}\" --ignore-path .gitignore",
    "lint:typecheck": "nuxt typecheck",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.3",
    "@tailwindcss/vite": "^4.3.0",
    "clsx": "^2.1.1",
    "nuxt": "4.4.6",
    "nuxt-viewport": "2.4.0",
    "pathe": "^2.0.3",
    "pinia": "^3.0.4",
    "swiper": "^12.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.5.34"
  },
  "packageManager": "yarn@4.15.0+sha512.07ec708ac11e2eaa4ea2b04cfbb272812f7e74a753f1595eaef4486c663a98306a30cca3e6fc40f7a0b168dcfb3a2490b6a5e0501e20fb69cc36f563dd161c53",
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxtjs/stylelint-module": "5.2.1",
    "@types/node": "25.9.3",
    "@vue/compiler-sfc": "^3.5.34",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "postcss": "^8.5.15",
    "postcss-html": "1.8.1",
    "prettier": "3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sass": "1.98.0",
    "stylelint": "17.13.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-prettier": "5.0.3",
    "typescript": "^6.0.3",
    "vite": "^7.1.12",
    "vue-tsc": "3.2.6"
  }
